{
  "expo": {
    "name": "Rega-me",
    "slug": "rega-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FDFDFC",
    "primaryColor": "#5D8C7B",
    "assetBundlePatterns": [
      "assets/*.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucasluchetta.regame"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#536343"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lucasluchetta.regame",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#7C9B72"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5D8C7B",
          "defaultChannel": "plant-care"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Rega-me usa suas fotos para você escolher a imagem de cada planta do seu jardim.",
          "cameraPermission": "O Rega-me usa a câmera para você fotografar suas plantas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Rega-me usa sua localização apenas para mostrar o clima do dia e ajustar os lembretes de rega.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "ee716770-dc18-4e0b-a8ac-2537e7ddefb3"
      }
    }
  }
}
