{
  // Site estático do Rega-me (apresentação + política de privacidade exigida
  // pela Google Play). Não há Worker: só a pasta docs/ servida como assets,
  // por isso não existe a chave "main".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rega-me",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./docs",
    // /privacy-policy serve privacy-policy.html sem exigir a extensão
    "html_handling": "auto-trailing-slash",
    // rotas inexistentes caem no docs/404.html
    "not_found_handling": "404-page"
  }
}
